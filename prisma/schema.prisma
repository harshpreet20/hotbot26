// Derived from the live database's information_schema (Postgres 17.6), not hand-written.
//
// NOTE: `prisma db pull` could not be run — this environment permits only proxied HTTPS,
// not raw TCP to 5432. Column names, types and nullability below were read directly from
// pg_catalog/information_schema, so they reflect the real database; primary keys are
// assumed to be `id` (`token` for sessions), matching every call site in src/lib/store.ts.
// Re-run `npx prisma db pull` from a machine with database access to confirm.
//
// Scope: only the tables this application uses. The database is shared with several
// unrelated apps (129 tables in `public` — a sports app, a content agent, event apps);
// those are deliberately omitted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── Auth & sessions ───────────────────────────────────────────────────────────

model BackdropUser {
  id           String    @id
  email        String
  username     String
  role         String
  status       String
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  invitedBy    String?   @map("invited_by")
  createdAt    DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(6)
  passwordHash String?   @map("password_hash")
  permissions  Json?

  @@map("backdrop_users")
}

model Session {
  token            String    @id
  userId           String    @map("user_id")
  username         String
  role             String
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastAccessAt     DateTime  @map("last_access_at") @db.Timestamptz(6)
  isImpersonating  Boolean   @map("is_impersonating")
  originalUserId   String?   @map("original_user_id")
  originalUsername String?   @map("original_username")
  originalRole     String?   @map("original_role")

  @@map("sessions")
}

model UserPermission {
  id        String   @id
  userId    String   @unique @map("user_id")
  grants    String[]
  revokes   String[]
  updatedBy String   @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("user_permissions")
}

model GoogleToken {
  id           String   @id
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiryDate   Float    @map("expiry_date")
  scope        String
  email        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("google_tokens")
}

// ── Inbound CRM ───────────────────────────────────────────────────────────────

model Lead {
  id              String    @id
  name            String
  email           String
  phone           String
  company         String
  service         String
  budget          String
  message         String
  formType        String    @map("form_type")
  source          String
  ip              String
  status          String
  tags            String[]
  notes           String
  lastUpdatedAt   DateTime? @map("last_updated_at") @db.Timestamptz(6)
  lastUpdatedBy   String    @map("last_updated_by")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  assignedTo      String?   @map("assigned_to")
  sessionId       String?   @map("session_id")
  journeyStage    String?   @map("journey_stage")
  meetUrl         String?   @map("meet_url")
  meetScheduledAt DateTime? @map("meet_scheduled_at") @db.Timestamptz(6)

  @@map("leads")
}

model Contact {
  id        String   @id
  name      String
  email     String
  phone     String
  subject   String
  message   String
  source    String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  sessionId String?  @map("session_id")

  @@map("contacts")
}

model Newsletter {
  id            String   @id
  name          String
  email         String
  whatsapp      String
  whatsappOptIn Boolean  @map("whatsapp_opt_in")
  source        String
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)

  @@map("newsletter")
}

model Callback {
  id        String   @id
  name      String
  phone     String
  source    String
  status    String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("callbacks")
}

model Chat {
  id              String    @id
  messages        Json
  ip              String
  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  lastMessageAt   DateTime  @map("last_message_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  needsHuman      Boolean   @map("needs_human")
  agentUsername   String?   @map("agent_username")
  agentTookOverAt DateTime? @map("agent_took_over_at") @db.Timestamptz(6)
  guestName       String?   @map("guest_name")
  guestEmail      String?   @map("guest_email")
  guestPhone      String?   @map("guest_phone")

  @@map("chats")
}

model CRMUpdate {
  id        String   @id
  leadId    String   @map("lead_id")
  type      String
  content   String
  author    String
  authorId  String   @map("author_id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by")
  metadata  Json?
  projectId String?  @map("project_id")

  @@map("crm_updates")
}

model CRMTask {
  id                String    @id
  title             String
  description       String
  status            String
  priority          String
  dueDate           DateTime? @map("due_date") @db.Timestamptz(6)
  assignedTo        String    @map("assigned_to")
  tags              String[]
  leadId            String?   @map("lead_id")
  createdBy         String    @map("created_by")
  updatedAt         DateTime? @map("updated_at") @db.Timestamptz(6)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  invoiceId         String?   @map("invoice_id")
  ticketId          String?   @map("ticket_id")
  clientId          String?   @map("client_id")
  blogId            String?   @map("blog_id")
  callbackId        String?   @map("callback_id")
  newsletterId      String?   @map("newsletter_id")
  linkedEntityType  String?   @map("linked_entity_type")
  linkedEntityLabel String    @map("linked_entity_label")
  projectId         String?   @map("project_id")

  @@map("crm_tasks")
}

// ── Tickets ───────────────────────────────────────────────────────────────────
// comments/activity are jsonb columns on this table, NOT relations.

model Ticket {
  id              String    @id
  number          String?
  subject         String?
  description     String
  status          String
  priority        String
  category        String
  clientName      String?   @map("client_name")
  clientEmail     String?   @map("client_email")
  assignedTo      String?   @map("assigned_to")
  tags            String[]
  comments        Json?
  activity        Json?
  createdBy       String?   @map("created_by")
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)
  ticketNumber    String?   @map("ticket_number")
  title           String?
  requesterName   String?   @map("requester_name")
  requesterEmail  String?   @map("requester_email")
  labels          String[]
  dueDate         String?   @map("due_date")
  ip              String?
  approvalStatus  String?   @map("approval_status")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")
  source          String?
  clientId        String?   @map("client_id")
  whiteboardData  Json?     @map("whiteboard_data")
  meetUrl         String?   @map("meet_url")
  isInternal      Boolean?  @map("is_internal")
  raisedAgainst   String?   @map("raised_against")
  raisedBy        String?   @map("raised_by")

  @@map("tickets")
}

// ── Billing ───────────────────────────────────────────────────────────────────

model Invoice {
  id            String    @id
  invoiceNumber String    @map("invoice_number")
  clientName    String    @map("client_name")
  clientEmail   String    @map("client_email")
  clientPhone   String    @map("client_phone")
  clientCompany String    @map("client_company")
  lineItems     Json      @map("line_items")
  subtotal      Decimal   @db.Decimal
  tax           Decimal   @db.Decimal
  discount      Decimal   @db.Decimal
  total         Decimal   @db.Decimal
  status        String
  currency      String
  notes         String
  dueDate       DateTime? @map("due_date") @db.Timestamptz(6)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  taxRate       Decimal   @map("tax_rate") @db.Decimal
  taxAmount     Decimal   @map("tax_amount") @db.Decimal
  issuedDate    String?   @map("issued_date")
  clientAddress String?   @map("client_address")
  terms         String?
  paidDate      String?   @map("paid_date")
  leadId        String?   @map("lead_id")
  lastUpdatedAt DateTime? @map("last_updated_at") @db.Timestamptz(6)
  lastUpdatedBy String?   @map("last_updated_by")

  @@map("invoices")
}

// ── Clients & delivery ────────────────────────────────────────────────────────

model Client {
  id                 String    @id
  clientId           String    @map("client_id")
  name               String
  email              String
  phone              String
  company            String
  status             String
  notes              String
  createdAt          DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(6)
  leadId             String?   @map("lead_id")
  onboardingStage    String?   @map("onboarding_stage")
  accountManager     String?   @map("account_manager")
  portalEnabled      Boolean?  @map("portal_enabled")
  portalInviteSentAt DateTime? @map("portal_invite_sent_at") @db.Timestamptz(6)
  subscriptionStatus String?   @map("subscription_status")
  industry           String?
  website            String?
  address            String?
  avatarUrl          String?   @map("avatar_url")
  tags               String[]
  customFields       Json?     @map("custom_fields")
  clientType         String?   @map("client_type")
  totalRevenue       Decimal?  @map("total_revenue") @db.Decimal
  outstandingBalance Decimal?  @map("outstanding_balance") @db.Decimal
  lastActivityAt     DateTime? @map("last_activity_at") @db.Timestamptz(6)
  accountStatus      String    @map("account_status")
  suspendedAt        DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspensionReason   String?   @map("suspension_reason")

  @@map("clients")
}

model Project {
  id              String    @id @db.Uuid
  projectNumber   String?   @map("project_number")
  clientId        String?   @map("client_id")
  name            String
  description     String?
  status          String?
  stage           String?
  priority        String?
  progress        Int?
  startDate       DateTime? @map("start_date") @db.Date
  targetDate      DateTime? @map("target_date") @db.Date
  completedDate   DateTime? @map("completed_date") @db.Date
  assignedTo      String[]  @map("assigned_to")
  accountManager  String?   @map("account_manager")
  budget          Decimal?  @db.Decimal
  currency        String?
  tags            String[]
  metadata        Json?
  createdBy       String?   @map("created_by")
  createdAt       DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @map("updated_at") @db.Timestamptz(6)
  whiteboardData  Json?     @map("whiteboard_data")
  meetUrl         String?   @map("meet_url")
  meetScheduledAt DateTime? @map("meet_scheduled_at") @db.Timestamptz(6)
  collabNotes     String?   @map("collab_notes")
  endDate         DateTime? @map("end_date") @db.Date
  color           String?
  clientEmail     String?   @map("client_email")
  clientName      String?   @map("client_name")

  @@map("projects")
}

model Meeting {
  id            String    @id
  title         String
  description   String?
  clientId      String?   @map("client_id")
  clientEmail   String?   @map("client_email")
  clientName    String?   @map("client_name")
  hostUsername  String    @map("host_username")
  attendees     Json?
  startTime     DateTime  @map("start_time") @db.Timestamptz(6)
  endTime       DateTime  @map("end_time") @db.Timestamptz(6)
  meetLink      String?   @map("meet_link")
  googleEventId String?   @map("google_event_id")
  status        String?
  notes         String?
  createdAt     DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  projectId     String?   @map("project_id")

  @@map("meetings")
}

model MeetingAttachment {
  id         String   @id
  meetingId  String   @map("meeting_id")
  name       String
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  fileSize   BigInt   @map("file_size")
  mimeType   String   @map("mime_type")
  category   String
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("meeting_attachments")
}

model ClientResource {
  id             String   @id
  clientId       String   @map("client_id")
  projectId      String?  @map("project_id")
  name           String
  description    String?
  fileUrl        String   @map("file_url")
  fileName       String   @map("file_name")
  fileSize       BigInt?  @map("file_size")
  mimeType       String   @map("mime_type")
  category       String
  uploadedBy     String?  @map("uploaded_by")
  uploadedByType String   @map("uploaded_by_type")
  visibility     String
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)

  @@map("client_resources")
}

model Document {
  id          String    @id
  title       String
  type        String?
  status      String?
  content     String?
  clientId    String    @map("client_id")
  clientEmail String?   @map("client_email")
  clientName  String?   @map("client_name")
  comments    Json?
  suggestions Json?
  signatures  Json?
  createdBy   String    @map("created_by")
  createdAt   DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)
  projectId   String?   @map("project_id")

  @@map("documents")
}

model Whiteboard {
  id           String    @id
  name         String
  clientId     String?   @map("client_id")
  clientEmail  String?   @map("client_email")
  elements     String?
  createdBy    String    @map("created_by")
  lastEditedBy String?   @map("last_edited_by")
  createdAt    DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)
  projectId    String?   @map("project_id")

  @@map("whiteboards")
}

model ProjectSOP {
  id           String    @id
  projectId    String    @map("project_id")
  clientId     String    @map("client_id")
  title        String
  brief        String?
  content      String?
  createdBy    String    @map("created_by")
  lastEditedBy String?   @map("last_edited_by")
  createdAt    DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("project_sops")
}

// ── Team chat ─────────────────────────────────────────────────────────────────

model TeamChannel {
  id          String   @id
  name        String
  description String
  createdBy   String   @map("created_by")
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)

  @@map("team_channels")
}

model TeamMessage {
  id          String    @id
  channel     String
  userId      String    @map("user_id")
  username    String
  role        String
  text        String
  attachments Json
  reactions   Json
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  channelId   String?   @map("channel_id")
  createdBy   String?   @map("created_by")
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(6)
  replyTo     String?   @map("reply_to")

  @@map("team_messages")
}

// ── Knowledge base ────────────────────────────────────────────────────────────

model AiKnowledgeBase {
  id        String    @id @db.Uuid
  title     String
  content   String
  category  String
  active    Boolean
  priority  Int
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by")

  @@map("ai_knowledge_base")
}

// ── Logging ───────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id
  action    String
  entity    String
  entityId  String   @map("entity_id")
  userId    String   @map("user_id")
  username  String
  role      String
  ip        String
  details   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("audit_logs")
}

model SystemLog {
  id        String   @id
  level     String
  event     String
  message   String
  ip        String
  username  String
  userId    String   @map("user_id")
  details   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("system_logs")
}
