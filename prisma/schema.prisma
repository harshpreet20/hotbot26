// Derived from the live database's information_schema (Postgres 17.6), not hand-written.
//
// NOTE: `prisma db pull` could not be run — this environment permits only proxied HTTPS,
// not raw TCP to 5432. Column names, types and nullability below were read directly from
// pg_catalog/information_schema, so they reflect the real database; primary keys are
// assumed to be `id` (`token` for sessions), matching every call site in src/lib/store.ts.
// Re-run `npx prisma db pull` from a machine with database access to confirm.
//
// Scope: only the tables this application uses. The database is shared with several
// unrelated apps (129 tables in `public` — a sports app, a content agent, event apps);
// those are deliberately omitted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── Auth & sessions ───────────────────────────────────────────────────────────

model BackdropUser {
  id           String    @id
  email        String
  username     String
  role         String
  status       String
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  invitedBy    String?   @map("invited_by")
  createdAt    DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(6)
  passwordHash String?   @map("password_hash")
  permissions  Json?

  @@map("backdrop_users")
}

model Session {
  token            String   @id
  userId           String   @map("user_id")
  username         String
  role             String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  lastAccessAt     DateTime @default(now()) @map("last_access_at") @db.Timestamptz(6)
  isImpersonating  Boolean  @default(false) @map("is_impersonating")
  originalUserId   String?  @map("original_user_id")
  originalUsername String?  @map("original_username")
  originalRole     String?  @map("original_role")

  @@map("sessions")
}

model UserPermission {
  id        String   @id
  userId    String   @unique @map("user_id")
  grants    String[] @default([])
  revokes   String[] @default([])
  updatedBy String   @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("user_permissions")
}

model GoogleToken {
  id           String   @id
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiryDate   Float    @map("expiry_date")
  scope        String
  email        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("google_tokens")
}

// ── Inbound CRM ───────────────────────────────────────────────────────────────

model Lead {
  id              String    @id
  name            String
  email           String
  phone           String    @default("")
  company         String    @default("")
  service         String    @default("")
  budget          String    @default("")
  message         String    @default("")
  formType        String    @default("get-started") @map("form_type")
  source          String    @default("unknown")
  ip              String    @default("")
  status          String    @default("new")
  tags            String[]  @default([])
  notes           String    @default("")
  lastUpdatedAt   DateTime? @map("last_updated_at") @db.Timestamptz(6)
  lastUpdatedBy   String    @default("") @map("last_updated_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  assignedTo      String?   @map("assigned_to")
  sessionId       String?   @map("session_id")
  journeyStage    String?   @default("lead") @map("journey_stage")
  meetUrl         String?   @map("meet_url")
  meetScheduledAt DateTime? @map("meet_scheduled_at") @db.Timestamptz(6)

  @@map("leads")
}

model Contact {
  id        String   @id
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String   @default("")
  source    String   @default("contact-page")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sessionId String?  @map("session_id")

  @@map("contacts")
}

model Newsletter {
  id            String   @id
  name          String   @default("")
  email         String
  whatsapp      String   @default("")
  whatsappOptIn Boolean  @default(false) @map("whatsapp_opt_in")
  source        String   @default("newsletter-signup")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("newsletter")
}

model Callback {
  id        String   @id
  name      String
  phone     String
  source    String   @default("chatbot-call-tab")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("callbacks")
}

model Chat {
  id              String    @id
  messages        Json      @default("[]")
  ip              String    @default("")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  lastMessageAt   DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  needsHuman      Boolean   @default(false) @map("needs_human")
  agentUsername   String?   @map("agent_username")
  agentTookOverAt DateTime? @map("agent_took_over_at") @db.Timestamptz(6)
  guestName       String?   @map("guest_name")
  guestEmail      String?   @map("guest_email")
  guestPhone      String?   @map("guest_phone")

  @@map("chats")
}

model CrmUpdate {
  id        String   @id
  leadId    String   @map("lead_id")
  type      String   @default("note")
  content   String   @default("")
  author    String   @default("")
  authorId  String   @default("") @map("author_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by")
  metadata  Json?
  projectId String?  @map("project_id")

  @@map("crm_updates")
}

model CrmTask {
  id                String    @id
  title             String
  description       String    @default("")
  status            String    @default("open")
  priority          String    @default("medium")
  dueDate           DateTime? @map("due_date") @db.Timestamptz(6)
  assignedTo        String    @default("") @map("assigned_to")
  tags              String[]  @default([])
  leadId            String?   @map("lead_id")
  createdBy         String    @default("") @map("created_by")
  updatedAt         DateTime? @map("updated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  invoiceId         String?   @map("invoice_id")
  ticketId          String?   @map("ticket_id")
  clientId          String?   @map("client_id")
  blogId            String?   @map("blog_id")
  callbackId        String?   @map("callback_id")
  newsletterId      String?   @map("newsletter_id")
  linkedEntityType  String?   @map("linked_entity_type")
  linkedEntityLabel String    @default("") @map("linked_entity_label")
  projectId         String?   @map("project_id")

  @@map("crm_tasks")
}

// ── Tickets ───────────────────────────────────────────────────────────────────
// comments/activity are jsonb columns on this table, NOT relations.

model Ticket {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  number          String?   @default("")
  subject         String?   @default("")
  description     String    @default("")
  status          String    @default("open")
  priority        String    @default("medium")
  category        String    @default("general")
  clientName      String?   @default("") @map("client_name")
  clientEmail     String?   @default("") @map("client_email")
  assignedTo      String?   @default("") @map("assigned_to")
  tags            String[]  @default([])
  comments        Json?     @default("[]")
  activity        Json?     @default("[]")
  createdBy       String?   @default("") @map("created_by")
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  ticketNumber    String?   @map("ticket_number")
  title           String?   @default("")
  requesterName   String?   @map("requester_name")
  requesterEmail  String?   @map("requester_email")
  labels          String[]
  dueDate         String?   @map("due_date")
  ip              String?
  approvalStatus  String?   @default("approved") @map("approval_status")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")
  source          String?   @default("admin")
  clientId        String?   @map("client_id")
  whiteboardData  Json?     @default("{}") @map("whiteboard_data")
  meetUrl         String?   @map("meet_url")
  isInternal      Boolean?  @default(false) @map("is_internal")
  raisedAgainst   String?   @map("raised_against")
  raisedBy        String?   @map("raised_by")

  @@map("tickets")
}

// ── Billing ───────────────────────────────────────────────────────────────────

model Invoice {
  id            String    @id
  invoiceNumber String    @map("invoice_number")
  clientName    String    @map("client_name")
  clientEmail   String    @map("client_email")
  clientPhone   String    @default("") @map("client_phone")
  clientCompany String    @default("") @map("client_company")
  lineItems     Json      @default("[]") @map("line_items")
  subtotal      Decimal   @default(0) @db.Decimal
  tax           Decimal   @default(0) @db.Decimal
  discount      Decimal   @default(0) @db.Decimal
  total         Decimal   @default(0) @db.Decimal
  status        String    @default("draft")
  currency      String    @default("INR")
  notes         String    @default("")
  dueDate       DateTime? @map("due_date") @db.Timestamptz(6)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  createdBy     String    @default("") @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  taxRate       Decimal   @default(0) @map("tax_rate") @db.Decimal
  taxAmount     Decimal   @default(0) @map("tax_amount") @db.Decimal
  issuedDate    String?   @map("issued_date")
  clientAddress String?   @map("client_address")
  terms         String?
  paidDate      String?   @map("paid_date")
  leadId        String?   @map("lead_id")
  lastUpdatedAt DateTime? @map("last_updated_at") @db.Timestamptz(6)
  lastUpdatedBy String?   @map("last_updated_by")

  @@map("invoices")
}

// ── Clients & delivery ────────────────────────────────────────────────────────

model Client {
  id                 String    @id
  clientId           String    @map("client_id")
  name               String    @default("")
  email              String    @default("")
  phone              String    @default("")
  company            String    @default("")
  status             String    @default("active")
  notes              String    @default("")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  leadId             String?   @map("lead_id")
  onboardingStage    String?   @default("prospect") @map("onboarding_stage")
  accountManager     String?   @map("account_manager")
  portalEnabled      Boolean?  @default(false) @map("portal_enabled")
  portalInviteSentAt DateTime? @map("portal_invite_sent_at") @db.Timestamptz(6)
  subscriptionStatus String?   @default("active") @map("subscription_status")
  industry           String?
  website            String?
  address            String?
  avatarUrl          String?   @map("avatar_url")
  tags               String[]  @default([])
  customFields       Json?     @default("{}") @map("custom_fields")
  clientType         String?   @default("business") @map("client_type")
  totalRevenue       Decimal?  @default(0) @map("total_revenue") @db.Decimal
  outstandingBalance Decimal?  @default(0) @map("outstanding_balance") @db.Decimal
  lastActivityAt     DateTime? @map("last_activity_at") @db.Timestamptz(6)
  accountStatus      String    @default("active") @map("account_status")
  suspendedAt        DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspensionReason   String?   @map("suspension_reason")

  @@map("clients")
}

model Project {
  id              String    @id @default(uuid()) @db.Uuid
  projectNumber   String?   @map("project_number")
  clientId        String?   @map("client_id")
  name            String
  description     String?
  status          String?   @default("active")
  stage           String?   @default("discovery")
  priority        String?   @default("medium")
  progress        Int?      @default(0)
  startDate       DateTime? @map("start_date") @db.Date
  targetDate      DateTime? @map("target_date") @db.Date
  completedDate   DateTime? @map("completed_date") @db.Date
  assignedTo      String[]  @default([]) @map("assigned_to")
  accountManager  String?   @map("account_manager")
  budget          Decimal?  @db.Decimal
  currency        String?   @default("INR")
  tags            String[]  @default([])
  metadata        Json?     @default("{}")
  createdBy       String?   @map("created_by")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  whiteboardData  Json?     @default("{}") @map("whiteboard_data")
  meetUrl         String?   @map("meet_url")
  meetScheduledAt DateTime? @map("meet_scheduled_at") @db.Timestamptz(6)
  collabNotes     String?   @map("collab_notes")
  endDate         DateTime? @map("end_date") @db.Date
  color           String?   @default("#6366f1")
  clientEmail     String?   @map("client_email")
  clientName      String?   @map("client_name")

  @@map("projects")
}

model Meeting {
  id            String    @id
  title         String
  description   String?
  clientId      String?   @map("client_id")
  clientEmail   String?   @map("client_email")
  clientName    String?   @map("client_name")
  hostUsername  String    @map("host_username")
  attendees     Json?     @default("[]")
  startTime     DateTime  @map("start_time") @db.Timestamptz(6)
  endTime       DateTime  @map("end_time") @db.Timestamptz(6)
  meetLink      String?   @map("meet_link")
  googleEventId String?   @map("google_event_id")
  status        String?   @default("scheduled")
  notes         String?
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  projectId     String?   @map("project_id")

  @@map("meetings")
}

model MeetingAttachment {
