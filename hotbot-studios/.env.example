# ─── Copy this file to .env.local and fill in your values ───────────────────
# Architecture:
#   Frontend (Next.js) → /api/n8n/* → n8n webhooks → Google Sheets + Sarvam AI + AI Sensy

# n8n Webhook Base URL
N8N_BASE_URL=https://n8n.yourdomain.com

# n8n Webhook Endpoints
# All lead capture (forms, contact page) → single webhook → Google Sheets
N8N_WEBHOOK_LEADS=/webhook/hotbotstudios-leads

# AI text chat (N8N LLM workflow)
N8N_WEBHOOK_CHAT=/webhook/hotbotstudios-chat

# Callback request → N8N → Sarvam AI outbound voice call
N8N_WEBHOOK_CALLBACK=/webhook/hotbotstudios-callback

# Newsletter subscriptions
N8N_WEBHOOK_NEWSLETTER=/webhook/hotbotstudios-newsletter

# Event tracking (fire-and-forget)
N8N_WEBHOOK_ANALYTICS=/webhook/hotbotstudios-analytics

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# App URL (used for OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://hotbotstudios.com
