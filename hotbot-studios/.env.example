# ─── Copy this file to .env.local and fill in your values ───────────────────
# Architecture:
#   Frontend (Next.js) → /api/n8n/* → n8n webhooks → Google Sheets + Sarvam AI + AI Sensy

# ── n8n Webhook Base URL ─────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.harshpreetbhasin.com

# ── 3 main-website pipelines ─────────────────────────────────────────────────
# Flow 1 — AI text chat + human handoff
N8N_WEBHOOK_CHAT=/webhook/hotbotstudios-chat

# Flow 2 — Sarvam AI voice callback (outbound call trigger)
N8N_WEBHOOK_VOICE=/webhook/hotbotstudios-voice

# Flow 3 — All forms (leads · newsletter · contact · analytics events)
N8N_WEBHOOK_FORMS=/webhook/hotbotstudios-forms

# ── Google Analytics 4 ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-5CNWV5X1KC

# ── App URL (used for OpenGraph metadata) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hotbotstudios.com

# ── Blog / Backdrop admin ────────────────────────────────────────────────────
N8N_WEBHOOK_BLOG_AUTH=hotbotstudios-blog-auth
N8N_WEBHOOK_BLOG_CREATE=hotbotstudios-blog-create
N8N_WEBHOOK_BLOG_SHEETS=hotbotstudios-blog-sheets
BLOG_PUBLISH_SECRET=change-me-strong-random-secret
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=change-me-strong-password

# ── reCAPTCHA v3 (optional — forms work without it) ──────────────────────────
# 1. Go to https://www.google.com/recaptcha/admin/create
# 2. Choose reCAPTCHA v3 → add your domain (localhost for dev)
# 3. Copy Site Key (public) and Secret Key (server-only)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
