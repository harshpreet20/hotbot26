# ─── Copy this file to .env.local and fill in your values ───────────────────

# n8n Webhook Base URL
N8N_BASE_URL=https://n8n.yourdomain.com

# n8n Webhook Endpoints (all pipelines)
N8N_WEBHOOK_CHAT=/webhook-test/hotbotstudios.com
N8N_WEBHOOK_VOICE=/webhook-test/hotbotstudios-voice
N8N_WEBHOOK_FORM=/webhook-test/hotbotstudios-form
N8N_WEBHOOK_LEADS=/webhook-test/hotbotstudios-leads
N8N_WEBHOOK_ANALYTICS=/webhook-test/hotbotstudios-analytics
N8N_WEBHOOK_CONTACT=/webhook-test/hotbotstudios-contact
N8N_WEBHOOK_NEWSLETTER=/webhook-test/hotbotstudios-newsletter

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# App URL (used for OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://hotbotstudios.com
