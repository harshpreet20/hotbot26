{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567806",
  "name": "HotBot — 06 Contact Pipeline",
  "nodes": [
    {
      "id": "node-webhook-contact",
      "name": "Webhook — Contact",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "hotbotstudios-contact",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "node-validate-contact",
      "name": "Validate Contact Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst name = (body.name || '').trim();\nconst email = (body.email || '').trim();\nconst phone = (body.phone || '').trim();\nconst subject = (body.subject || '').trim();\nconst message = (body.message || '').trim();\nconst meta = body._meta || {};\n\nif (!name || name.length < 2) throw new Error('Name is required');\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Valid email is required');\nif (!message || message.length < 10) throw new Error('Message is too short');\n\nconst ticketId = 'TKT-' + Date.now();\nconst timestamp = new Date().toISOString();\n\n// Auto-route based on subject keyword\nconst subjectLower = subject.toLowerCase();\nconst department = subjectLower.includes('sales') || subjectLower.includes('price') || subjectLower.includes('quote') ? 'sales'\n  : subjectLower.includes('support') || subjectLower.includes('bug') || subjectLower.includes('issue') ? 'support'\n  : subjectLower.includes('partner') || subjectLower.includes('collab') ? 'partnerships'\n  : 'general';\n\nreturn [{\n  json: {\n    ticketId,\n    timestamp,\n    name,\n    email,\n    phone,\n    subject: subject || 'General Inquiry',\n    message,\n    department,\n    source: meta.source || 'contact-page'\n  }\n}];"
      }
    },
    {
      "id": "node-sheets-contact",
      "name": "Google Sheets — Log Contact",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [720, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GSHEETS_CRED_ID",
          "name": "Google Sheets OAuth2"
        }
      },
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "ContactRequests",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Ticket ID": "={{ $json.ticketId }}",
            "Timestamp": "={{ $json.timestamp }}",
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "Subject": "={{ $json.subject }}",
            "Message": "={{ $json.message }}",
            "Department": "={{ $json.department }}",
            "Source": "={{ $json.source }}",
            "Status": "open"
          }
        },
        "options": {}
      }
    },
    {
      "id": "node-notify-split",
      "name": "Parallel Notify",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 300],
      "parameters": {}
    },
    {
      "id": "node-telegram-contact",
      "name": "Telegram — Contact Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 160],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=📬 *New Contact Request — {{ $json.ticketId }}*\n\n👤 *From:* {{ $json.name }}\n📧 *Email:* {{ $json.email }}\n📞 *Phone:* {{ $json.phone || 'N/A' }}\n📋 *Subject:* {{ $json.subject }}\n🏢 *Dept:* {{ $json.department }}\n\n💬 *Message:*\n{{ $json.message }}\n\n⏰ {{ $json.timestamp }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "node-email-contact-team",
      "name": "Send Email — Team Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1200, 300],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CRED_ID",
          "name": "SMTP"
        }
      },
      "parameters": {
        "fromEmail": "noreply@hotbotstudios.com",
        "toEmail": "={{ $json.department === 'sales' ? 'sales@hotbotstudios.com' : $json.department === 'support' ? 'support@hotbotstudios.com' : 'hello@hotbotstudios.com' }}",
        "subject": "=[{{ $json.department.toUpperCase() }}] New Contact: {{ $json.name }} — {{ $json.ticketId }}",
        "emailType": "html",
        "message": "=<h2>New Contact Request</h2>\n<p><strong>Ticket:</strong> {{ $json.ticketId }}</p>\n<p><strong>Department:</strong> {{ $json.department }}</p>\n<table border='1' cellpadding='8'>\n  <tr><th>Name</th><td>{{ $json.name }}</td></tr>\n  <tr><th>Email</th><td>{{ $json.email }}</td></tr>\n  <tr><th>Phone</th><td>{{ $json.phone || 'N/A' }}</td></tr>\n  <tr><th>Subject</th><td>{{ $json.subject }}</td></tr>\n  <tr><th>Message</th><td>{{ $json.message }}</td></tr>\n  <tr><th>Time</th><td>{{ $json.timestamp }}</td></tr>\n</table>"
      }
    },
    {
      "id": "node-email-contact-user",
      "name": "Send Email — User Confirmation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1200, 440],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CRED_ID",
          "name": "SMTP"
        }
      },
      "parameters": {
        "fromEmail": "hello@hotbotstudios.com",
        "toEmail": "={{ $json.email }}",
        "subject": "=We received your message — {{ $json.ticketId }}",
        "emailType": "html",
        "message": "=<h2>Hi {{ $json.name }},</h2>\n<p>Thank you for reaching out to HotBot Studios!</p>\n<p>We've received your message regarding <strong>{{ $json.subject }}</strong> and will get back to you within <strong>24 hours</strong>.</p>\n<p><strong>Reference:</strong> {{ $json.ticketId }}</p>\n<hr/>\n<p>In the meantime, explore our services at <a href='https://hotbotstudios.com'>hotbotstudios.com</a></p>\n<p>Best regards,<br/><strong>HotBot Studios Team</strong></p>"
      }
    },
    {
      "id": "node-respond-contact",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, ticketId: $('Validate Contact Fields').first().json.ticketId, message: 'Message received! We will respond within 24 hours.' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook — Contact": {
      "main": [
        [{ "node": "Validate Contact Fields", "type": "main", "index": 0 }]
      ]
    },
    "Validate Contact Fields": {
      "main": [
        [{ "node": "Google Sheets — Log Contact", "type": "main", "index": 0 }]
      ]
    },
    "Google Sheets — Log Contact": {
      "main": [
        [{ "node": "Parallel Notify", "type": "main", "index": 0 }]
      ]
    },
    "Parallel Notify": {
      "main": [
        [
          { "node": "Telegram — Contact Alert", "type": "main", "index": 0 },
          { "node": "Send Email — Team Alert", "type": "main", "index": 0 },
          { "node": "Send Email — User Confirmation", "type": "main", "index": 0 }
        ]
      ]
    },
    "Telegram — Contact Alert": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    },
    "Send Email — Team Alert": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    },
    "Send Email — User Confirmation": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    { "id": "tag-hotbot", "name": "hotbot-studios" },
    { "id": "tag-contact", "name": "contact-pipeline" }
  ],
  "pinData": {}
}
