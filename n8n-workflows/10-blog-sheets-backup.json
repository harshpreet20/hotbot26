{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567810",
  "name": "HotBot — 10 Blog → Google Sheets Backup",
  "nodes": [
    {
      "id": "node-webhook-sheets",
      "name": "Webhook — Blog Sheets",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "hotbotstudios-blog-sheets",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },

    {
      "id": "node-prepare",
      "name": "Prepare Row Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// Flatten the incoming post payload into sheet-friendly columns\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    id:               body.id               || '',\n    slug:             body.slug             || '',\n    title:            body.title            || '',\n    status:           body.status           || 'published',\n    category:         body.category         || '',\n    author:           body.author           || 'HotBot Studios',\n    publishedAt:      body.publishedAt      || now,\n    updatedAt:        body.updatedAt        || now,\n    tags:             body.tags             || '',\n    readTime:         body.readTime         || '',\n    excerpt:          body.excerpt          || '',\n    featuredImage:    body.featuredImage    || '',\n    featuredImageAlt: body.featuredImageAlt || '',\n    adTopic:          body.adTopic          || 'general',\n    url:              body.url              || '',\n    // SEO fields\n    metaTitle:        body.metaTitle        || body.title || '',\n    metaDescription:  body.metaDescription  || body.excerpt || '',\n    focusKeyword:     body.focusKeyword     || '',\n    seoScore:         String(body.seoScore  || 0),\n    // Backup timestamp\n    backedUpAt:       now\n  }\n}];"
      }
    },

    {
      "id": "node-check-exists",
      "name": "Find Existing Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [720, 300],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.SHEETS_BLOG_DOC_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Posts",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "slug",
              "lookupValue": "={{ $json.slug }}"
            }
          ]
        },
        "options": {
          "returnAllMatches": false
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred",
          "name": "Google Sheets Account"
        }
      }
    },

    {
      "id": "node-if-exists",
      "name": "IF — Row Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-exists",
              "leftValue": "={{ $json.slug }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },

    {
      "id": "node-update-row",
      "name": "Update Existing Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1200, 200],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.SHEETS_BLOG_DOC_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Posts",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["slug"],
          "values": {
            "id":               "={{ $('Prepare Row Data').first().json.id }}",
            "slug":             "={{ $('Prepare Row Data').first().json.slug }}",
            "title":            "={{ $('Prepare Row Data').first().json.title }}",
            "status":           "={{ $('Prepare Row Data').first().json.status }}",
            "category":         "={{ $('Prepare Row Data').first().json.category }}",
            "author":           "={{ $('Prepare Row Data').first().json.author }}",
            "publishedAt":      "={{ $('Prepare Row Data').first().json.publishedAt }}",
            "updatedAt":        "={{ $('Prepare Row Data').first().json.updatedAt }}",
            "tags":             "={{ $('Prepare Row Data').first().json.tags }}",
            "readTime":         "={{ $('Prepare Row Data').first().json.readTime }}",
            "excerpt":          "={{ $('Prepare Row Data').first().json.excerpt }}",
            "featuredImage":    "={{ $('Prepare Row Data').first().json.featuredImage }}",
            "featuredImageAlt": "={{ $('Prepare Row Data').first().json.featuredImageAlt }}",
            "adTopic":          "={{ $('Prepare Row Data').first().json.adTopic }}",
            "url":              "={{ $('Prepare Row Data').first().json.url }}",
            "metaTitle":        "={{ $('Prepare Row Data').first().json.metaTitle }}",
            "metaDescription":  "={{ $('Prepare Row Data').first().json.metaDescription }}",
            "focusKeyword":     "={{ $('Prepare Row Data').first().json.focusKeyword }}",
            "seoScore":         "={{ $('Prepare Row Data').first().json.seoScore }}",
            "backedUpAt":       "={{ $('Prepare Row Data').first().json.backedUpAt }}"
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred",
          "name": "Google Sheets Account"
        }
      }
    },

    {
      "id": "node-append-row",
      "name": "Append New Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1200, 420],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.SHEETS_BLOG_DOC_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Posts",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "values": {
            "id":               "={{ $('Prepare Row Data').first().json.id }}",
            "slug":             "={{ $('Prepare Row Data').first().json.slug }}",
            "title":            "={{ $('Prepare Row Data').first().json.title }}",
            "status":           "={{ $('Prepare Row Data').first().json.status }}",
            "category":         "={{ $('Prepare Row Data').first().json.category }}",
            "author":           "={{ $('Prepare Row Data').first().json.author }}",
            "publishedAt":      "={{ $('Prepare Row Data').first().json.publishedAt }}",
            "updatedAt":        "={{ $('Prepare Row Data').first().json.updatedAt }}",
            "tags":             "={{ $('Prepare Row Data').first().json.tags }}",
            "readTime":         "={{ $('Prepare Row Data').first().json.readTime }}",
            "excerpt":          "={{ $('Prepare Row Data').first().json.excerpt }}",
            "featuredImage":    "={{ $('Prepare Row Data').first().json.featuredImage }}",
            "featuredImageAlt": "={{ $('Prepare Row Data').first().json.featuredImageAlt }}",
            "adTopic":          "={{ $('Prepare Row Data').first().json.adTopic }}",
            "url":              "={{ $('Prepare Row Data').first().json.url }}",
            "metaTitle":        "={{ $('Prepare Row Data').first().json.metaTitle }}",
            "metaDescription":  "={{ $('Prepare Row Data').first().json.metaDescription }}",
            "focusKeyword":     "={{ $('Prepare Row Data').first().json.focusKeyword }}",
            "seoScore":         "={{ $('Prepare Row Data').first().json.seoScore }}",
            "backedUpAt":       "={{ $('Prepare Row Data').first().json.backedUpAt }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred",
          "name": "Google Sheets Account"
        }
      }
    },

    {
      "id": "node-respond",
      "name": "Respond — OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1440, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"action\": \"synced\", \"slug\": \"{{ $('Prepare Row Data').first().json.slug }}\" }"
      }
    }
  ],

  "connections": {
    "Webhook — Blog Sheets": {
      "main": [[{ "node": "Prepare Row Data", "type": "main", "index": 0 }]]
    },
    "Prepare Row Data": {
      "main": [[{ "node": "Find Existing Row", "type": "main", "index": 0 }]]
    },
    "Find Existing Row": {
      "main": [[{ "node": "IF — Row Exists?", "type": "main", "index": 0 }]]
    },
    "IF — Row Exists?": {
      "main": [
        [{ "node": "Update Existing Row", "type": "main", "index": 0 }],
        [{ "node": "Append New Row", "type": "main", "index": 0 }]
      ]
    },
    "Update Existing Row": {
      "main": [[{ "node": "Respond — OK", "type": "main", "index": 0 }]]
    },
    "Append New Row": {
      "main": [[{ "node": "Respond — OK", "type": "main", "index": 0 }]]
    }
  },

  "settings": {
    "executionOrder": "v1"
  },

  "meta": {
    "templateId": "hotbot-10-blog-sheets",
    "templateCreatedBy": "HotBot Studios",
    "instanceId": "hotbotstudios"
  },

  "__setup_notes__": {
    "1_google_sheets": "Create a Google Sheet named 'HotBot Blog Posts'. Add a tab called 'Posts'. Row 1 headers (exact order): id | slug | title | status | category | author | publishedAt | updatedAt | tags | readTime | excerpt | featuredImage | featuredImageAlt | adTopic | url | metaTitle | metaDescription | focusKeyword | seoScore | backedUpAt",
    "2_credential": "In n8n → Credentials → New → Google Sheets OAuth2. Authenticate with your Google account.",
    "3_env_var": "In n8n → Settings → Variables → Add: SHEETS_BLOG_DOC_ID = the Google Sheets document ID (from the URL: /spreadsheets/d/[THIS_PART]/edit)",
    "4_update_cred_id": "Replace 'google-sheets-cred' in this JSON with the actual credential ID from your n8n instance after creating the credential.",
    "5_webhook_url": "Webhook path: hotbotstudios-blog-sheets — matches N8N_WEBHOOK_BLOG_SHEETS in .env.local"
  }
}
