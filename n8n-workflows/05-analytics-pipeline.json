{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567805",
  "name": "HotBot — 05 Analytics Pipeline",
  "nodes": [
    {
      "id": "node-webhook-analytics",
      "name": "Webhook — Analytics",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "hotbotstudios-analytics",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "node-respond-fast",
      "name": "Respond Immediately (fire-and-forget)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 180],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "node-parse-event",
      "name": "Parse & Enrich Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 420],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst event = (body.event || 'pageview').toLowerCase();\nconst page = body.page || body.path || '/';\nconst meta = body._meta || {};\nconst userAgent = body.userAgent || '';\nconst referrer = body.referrer || '';\nconst sessionId = body.sessionId || '';\nconst timestamp = new Date().toISOString();\n\n// Classify event value\nconst highValueEvents = ['form_submit', 'chat_open', 'voice_start', 'cta_click', 'get_started', 'contact_submit'];\nconst isHighValue = highValueEvents.includes(event);\n\nreturn [{\n  json: {\n    event,\n    page,\n    sessionId,\n    referrer,\n    userAgent,\n    timestamp,\n    isHighValue,\n    source: meta.source || 'website'\n  }\n}];"
      }
    },
    {
      "id": "node-sheets-analytics",
      "name": "Google Sheets — Log Event",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [720, 420],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GSHEETS_CRED_ID",
          "name": "Google Sheets OAuth2"
        }
      },
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Analytics",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.timestamp }}",
            "Event": "={{ $json.event }}",
            "Page": "={{ $json.page }}",
            "Session ID": "={{ $json.sessionId }}",
            "Referrer": "={{ $json.referrer }}",
            "User Agent": "={{ $json.userAgent }}",
            "High Value": "={{ $json.isHighValue ? 'YES' : 'NO' }}",
            "Source": "={{ $json.source }}"
          }
        },
        "options": {}
      }
    },
    {
      "id": "node-if-high-value",
      "name": "IF — High Value Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 420],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-high-value",
              "leftValue": "={{ $json.isHighValue }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-telegram-analytics",
      "name": "Telegram — High Value Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 320],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=⚡ *High-Value Event Detected*\n\n🎯 *Event:* {{ $json.event }}\n📄 *Page:* {{ $json.page }}\n🔗 *Referrer:* {{ $json.referrer || 'Direct' }}\n🕐 *Time:* {{ $json.timestamp }}\n📍 *Session:* {{ $json.sessionId || 'N/A' }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    }
  ],
  "connections": {
    "Webhook — Analytics": {
      "main": [
        [
          { "node": "Respond Immediately (fire-and-forget)", "type": "main", "index": 0 },
          { "node": "Parse & Enrich Event", "type": "main", "index": 0 }
        ]
      ]
    },
    "Parse & Enrich Event": {
      "main": [
        [{ "node": "Google Sheets — Log Event", "type": "main", "index": 0 }]
      ]
    },
    "Google Sheets — Log Event": {
      "main": [
        [{ "node": "IF — High Value Event?", "type": "main", "index": 0 }]
      ]
    },
    "IF — High Value Event?": {
      "main": [
        [{ "node": "Telegram — High Value Alert", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    { "id": "tag-hotbot", "name": "hotbot-studios" },
    { "id": "tag-analytics", "name": "analytics-pipeline" }
  ],
  "pinData": {}
}
