{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567807",
  "name": "HotBot — 07 Newsletter Pipeline",
  "nodes": [
    {
      "id": "node-webhook-newsletter",
      "name": "Webhook — Newsletter",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "hotbotstudios-newsletter",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "node-validate-newsletter",
      "name": "Validate Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst email = (body.email || '').trim().toLowerCase();\nconst name = (body.name || '').trim();\nconst source = body.source || body._meta?.source || 'website-footer';\n\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  throw new Error('Valid email address is required');\n}\n\nreturn [{\n  json: {\n    email,\n    name: name || email.split('@')[0],\n    source,\n    subscribedAt: new Date().toISOString(),\n    status: 'active'\n  }\n}];"
      }
    },
    {
      "id": "node-sheets-newsletter",
      "name": "Google Sheets — Add Subscriber",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [720, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GSHEETS_CRED_ID",
          "name": "Google Sheets OAuth2"
        }
      },
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Newsletter",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Email": "={{ $json.email }}",
            "Name": "={{ $json.name }}",
            "Subscribed At": "={{ $json.subscribedAt }}",
            "Source": "={{ $json.source }}",
            "Status": "={{ $json.status }}"
          }
        },
        "options": {}
      }
    },
    {
      "id": "node-brevo-add",
      "name": "Brevo — Add to List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/contacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "YOUR_BREVO_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.email, firstName: $json.name.split(' ')[0], lastName: $json.name.split(' ').slice(1).join(' ') || '', listIds: [YOUR_BREVO_LIST_ID], updateEnabled: true, attributes: { SOURCE: $json.source, SUBSCRIBED_AT: $json.subscribedAt } }) }}",
        "options": {
          "ignoreHttpStatusErrors": true
        }
      }
    },
    {
      "id": "node-welcome-email",
      "name": "Send Email — Welcome",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [960, 380],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CRED_ID",
          "name": "SMTP"
        }
      },
      "parameters": {
        "fromEmail": "hello@hotbotstudios.com",
        "toEmail": "={{ $json.email }}",
        "subject": "Welcome to HotBot Studios — You're in!",
        "emailType": "html",
        "message": "=<div style='font-family: sans-serif; max-width: 600px; margin: 0 auto;'>\n  <div style='background: linear-gradient(135deg, #0ea5e9, #8b5cf6); padding: 40px; text-align: center;'>\n    <h1 style='color: white; margin: 0;'>Welcome to HotBot Studios</h1>\n  </div>\n  <div style='padding: 40px; background: #0f0f14;'>\n    <h2 style='color: #e2e8f0;'>Hi {{ $json.name }},</h2>\n    <p style='color: #94a3b8;'>You've joined the HotBot Studios community! Get ready for:</p>\n    <ul style='color: #94a3b8;'>\n      <li>🤖 AI automation tips & case studies</li>\n      <li>📈 Digital marketing insights</li>\n      <li>🛠️ Exclusive tools and templates</li>\n      <li>🎯 Early access to new products</li>\n    </ul>\n    <div style='text-align: center; margin: 30px 0;'>\n      <a href='https://hotbotstudios.com' style='background: #0ea5e9; color: white; padding: 12px 30px; text-decoration: none; border-radius: 6px;'>Explore Our Services</a>\n    </div>\n    <p style='color: #64748b; font-size: 12px;'>You subscribed from: {{ $json.source }}. <a href='https://hotbotstudios.com/unsubscribe?email={{ $json.email }}' style='color: #64748b;'>Unsubscribe</a></p>\n  </div>\n</div>"
      }
    },
    {
      "id": "node-telegram-subscriber",
      "name": "Telegram — New Subscriber Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 520],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=📧 *New Newsletter Subscriber*\n\n✉️ {{ $json.email }}\n👤 {{ $json.name }}\n🔗 Source: {{ $json.source }}\n⏰ {{ $json.subscribedAt }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "node-respond-newsletter",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 360],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Subscribed! Check your email for a welcome message.' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook — Newsletter": {
      "main": [
        [{ "node": "Validate Email", "type": "main", "index": 0 }]
      ]
    },
    "Validate Email": {
      "main": [
        [{ "node": "Google Sheets — Add Subscriber", "type": "main", "index": 0 }]
      ]
    },
    "Google Sheets — Add Subscriber": {
      "main": [
        [
          { "node": "Brevo — Add to List", "type": "main", "index": 0 },
          { "node": "Send Email — Welcome", "type": "main", "index": 0 },
          { "node": "Telegram — New Subscriber Alert", "type": "main", "index": 0 }
        ]
      ]
    },
    "Brevo — Add to List": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    },
    "Send Email — Welcome": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    },
    "Telegram — New Subscriber Alert": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    { "id": "tag-hotbot", "name": "hotbot-studios" },
    { "id": "tag-newsletter", "name": "newsletter-pipeline" }
  ],
  "pinData": {}
}
