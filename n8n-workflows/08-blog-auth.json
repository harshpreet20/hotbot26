{
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567808",
  "name": "HotBot — 08 Blog Auth",
  "nodes": [
    {
      "id": "node-webhook-auth",
      "name": "Webhook — Blog Auth",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "hotbotstudios-blog-auth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "node-validate-against-db",
      "name": "Validate Against DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SITE_URL }}/api/blog/auth/validate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-N8N-Secret",
              "value": "={{ $env.N8N_AUTH_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ ($input.first().json.body || $input.first().json).username }}"
            },
            {
              "name": "password",
              "value": "={{ ($input.first().json.body || $input.first().json).password }}"
            }
          ]
        },
        "options": {
          "timeout": 8000,
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      }
    },
    {
      "id": "node-if-valid",
      "name": "IF — Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-respond-success",
      "name": "Respond — Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ valid: true, userId: $json.userId, username: $json.username, role: $json.role }) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      }
    },
    {
      "id": "node-respond-error",
      "name": "Respond — Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 420],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ valid: false, error: 'Invalid username or password.' }) }}",
        "options": {
          "responseCode": 401,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "Webhook — Blog Auth": {
      "main": [
        [
          {
            "node": "Validate Against DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Against DB": {
      "main": [
        [
          {
            "node": "IF — Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF — Valid?": {
      "main": [
        [
          {
            "node": "Respond — Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond — Unauthorized",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "meta": {
    "description": "Authenticates Backdrop login requests for super admin and all sub-accounts. Validates credentials against the existing Supabase/filesystem database via /api/blog/auth/validate, then returns { valid, userId, username, role } so the Next.js auth route can create a session in the existing database. N8N env vars required: SITE_URL (e.g. https://hotbotstudios.com), N8N_AUTH_SECRET (shared secret matching the app env var).",
    "tags": ["blog", "auth", "admin", "supabase"]
  },
  "active": true
}
