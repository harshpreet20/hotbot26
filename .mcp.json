{
  "mcpServers": {
    "google-analytics": {
      "command": "npx",
      "args": ["-y", "@googleanalytics/mcp"],
      "env": {
        "GA_PROPERTY_ID": "${GA4_PROPERTY_ID}",
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "${SUPABASE_ACCESS_TOKEN}",
        "--project-ref",
        "wsucqpunleplgyrrroae"
      ]
    }
  }
}
