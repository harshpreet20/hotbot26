# ─── Copy this file to .env.local and fill in your values ───────────────────
# Architecture:
#   Next.js API routes → local filesystem storage (CRM is fully native)
#   Chat / Voice / Blog → N8N workflow webhooks

# ── Auth.js (NextAuth v5) ──────────────────────────────────────────────────────
# Required: generate with: openssl rand -base64 32
AUTH_SECRET=your_32_char_random_secret_here
# Optional: your app's canonical URL (for Auth.js callbacks)
NEXTAUTH_URL=https://your-domain.com

# ── N8N Workflow Webhooks (active) ────────────────────────────────────────────
# Workflow 1 — Forms (initial lead intake)
N8N_WEBHOOK_FORMS=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-forms

# Workflow 2 — Chat (AI + Human Handoff)
N8N_WEBHOOK_CHAT=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-chat

# Workflow 3 — Voice Agent (Sarvam AI outbound call trigger)
N8N_WEBHOOK_VOICE=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-voice

# Workflow 8 — Blog Create & Publish
N8N_WEBHOOK_BLOG_CREATE=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-blog-create

# Workflow 9 — Blog Auth (Backdrop login) — do not remove
# When set, all login attempts (super admin + sub-accounts) route through this N8N
# webhook, which validates credentials against the existing database via
# /api/blog/auth/validate, then the auth route creates the session locally.
# Falls back to direct DB auth if N8N is unreachable.
N8N_WEBHOOK_BLOG_AUTH_URL=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-blog-auth

# Shared secret between this app and N8N — set the same value in both:
#   App:  N8N_AUTH_SECRET (here)
#   N8N:  Environment variable N8N_AUTH_SECRET in your n8n instance
# /api/blog/auth/validate rejects requests that do not include this secret in
# the X-N8N-Secret header, preventing unauthenticated credential-check abuse.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_AUTH_SECRET=your_n8n_auth_secret_here

# Workflow 10 — Blog → Google Sheets Backup
N8N_WEBHOOK_BLOG_SHEETS=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-blog-sheets

# ── Google Analytics 4 ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-5CNWV5X1KC

# ── App URL (used for OpenGraph metadata) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hotbotstudios.com

# ── Blog / Backdrop admin ────────────────────────────────────────────────────
# Username for the env-var fallback admin account (defaults to "admin")
BLOG_ADMIN_USERNAME=admin
# bcrypt hash of the admin password (cost 12). Pre-hashed for: Hotbotstudios
# Regenerate with: node -e "require('bcryptjs').hash('YourNewPassword',12).then(console.log)"
BLOG_ADMIN_PASSWORD_HASH='$2b$12$nMk6oS00R.r9/qLpZbClSODAXxibghu4SBa7fv.QqVFUUJqay6Qiu'
# Random secret used for legacy API access and N8N webhook auth
BLOG_PUBLISH_SECRET=d4fb0c403a1a5a909ab66027443b0a66c03f400cc7647be2059c4682654cb841

# ── reCAPTCHA v3 (optional — forms work without it) ──────────────────────────
# 1. Go to https://www.google.com/recaptcha/admin/create
# 2. Choose reCAPTCHA v3 → add your domain (localhost for dev)
# 3. Copy Site Key (public) and Secret Key (server-only)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lccj-8sAAAAALbFFIwQVcC3BqItxqruAc2I1-jW
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ── Google Analytics 4 (server-side analytics dashboard + AI insights) ──────
# 1. Go to Google Analytics → Admin → Property Settings → copy the numeric Property ID
# 2. Go to Google Cloud Console → IAM & Admin → Service Accounts → Create Service Account
#    - Name: "hotbot-analytics-reader"
#    - Role: none needed at project level
# 3. Generate a JSON key: Service Account → Keys → Add Key → JSON → download
# 4. In GA4: Admin → Property Access Management → Add user → paste service account email
#    - Role: Viewer
# 5. Paste the ENTIRE downloaded JSON (single line) as GA4_SERVICE_ACCOUNT_JSON
GA4_PROPERTY_ID=123456789
GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"abc123","private_key":"-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----\n","client_email":"hotbot-analytics-reader@your-project.iam.gserviceaccount.com","client_id":"123","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Resend (transactional email — registration, reset, tickets, chat transcripts) ────
# 1. Sign up at https://resend.com and verify your sending domain (e.g. hotbotstudios.com)
# 2. Create an API key at: Resend Dashboard → API Keys → Create API Key
# 3. Set RESEND_FROM_EMAIL to an address on your verified domain
# NOTE: If you send from a Google Workspace address (e.g. hello@hotbotstudios.com),
#       you must verify hotbotstudios.com in Resend (add DNS TXT/MX/DKIM records).
#       See the RESEND SETUP GUIDE section at the bottom of this file.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@hotbotstudios.com
RESEND_FROM_NAME=HotBot Studios
TEAM_NOTIFY_EMAILS=admin@example.com,team@example.com
# Resend webhook signing secret — get this from Resend Dashboard → Webhooks → your endpoint → Signing Secret
# Leave blank to accept webhooks without signature verification (not recommended in production)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (AI chatbot + visiting card scanner) ──────────────────────────────
# Powers the HotBot AI chat widget and the "Scan Card" vision feature in Leads.
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── GitHub (optional — blog post persistence across Vercel redeploys) ─────────
GITHUB_TOKEN=
GITHUB_REPO=harshpreet20/hotbot26
GITHUB_BRANCH=main

# ── Google Workspace Email (invoice sending via Gmail SMTP) ───────────────────
# 1. Use a Google Workspace account (e.g. billing@hotbotstudios.com)
# 2. Enable 2-Step Verification on the Google Workspace account
# 3. Generate an App Password: Google Account → Security → App Passwords
#    (Select app: Mail, device: Other → name it "HotBot Invoices")
# 4. Paste the 16-character App Password (no spaces) into GMAIL_APP_PASSWORD
#
# SMTP settings (hardcoded): host=smtp.gmail.com, port=587, STARTTLS
GMAIL_FROM_NAME=HotBot Studios
GMAIL_FROM_EMAIL=billing@hotbotstudios.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ── Prisma ORM (Supabase PostgreSQL) ─────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the Transaction (PgBouncer) pooler URL for runtime queries:
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (non-pooled) — only needed when running: npx prisma migrate
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# Run after setting DATABASE_URL: npx prisma db pull && npx prisma generate

# ── Supabase (Auth + Database) ───────────────────────────────────────────────
# Project URL (always public):
SUPABASE_URL=https://wsucqpunleplgyrrroae.supabase.co
# Service role key — get from: Supabase Dashboard → Project Settings → API → service_role
# WARNING: Never expose this key on the client side. Server/API routes only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
#
# Supabase Auth is used for all Backdrop (admin dashboard) authentication:
#  - Registration with email verification
#  - Login (email + password)
#  - Password reset via email
#  - Admin approval workflow via backdrop_users table
#
# Tables: leads, contacts, callbacks, newsletter, chats, crm_tasks, invoices,
#         tickets, posts, audit_logs, system_logs, team_messages, seo_scores,
#         analytics_snapshots, topic_suggestions, crm_updates, backdrop_users,
#         team_channels, sessions
#
# When these vars are set, all data and authentication go through Supabase.
# Without them, the app falls back to local JSON files + bcrypt auth (dev mode).
#
# First-time setup: The first successful login via Supabase Auth is automatically
# bootstrapped as super_admin (if no approved users exist yet).

# ═══════════════════════════════════════════════════════════════════════════════
# RESEND SETUP GUIDE — Sending from your Google Workspace domain
# ═══════════════════════════════════════════════════════════════════════════════
#
# Resend sends emails on behalf of YOUR domain (e.g. hello@hotbotstudios.com).
# It does NOT use Gmail SMTP — Resend has its own infrastructure. You only need
# to prove you own the domain by adding DNS records. Your Google Workspace inbox
# still receives replies normally.
#
# STEP 1 — Create a Resend account
#   → Go to https://resend.com and sign up (free tier: 3,000 emails/month, 100/day)
#
# STEP 2 — Add and verify your domain
#   a. In Resend Dashboard → Domains → Add Domain
#   b. Enter "hotbotstudios.com"
#   c. Resend shows you DNS records to add (SPF, DKIM, DMARC). Add them in your
#      DNS provider (e.g. Cloudflare, GoDaddy, Google Domains):
#
#      Type  Name                         Value
#      TXT   @  (or blank)               "v=spf1 include:amazonses.com ~all"
#             (if you already have an SPF record, ADD include:amazonses.com to it)
#      CNAME resend._domainkey            (Resend provides this value)
#      TXT   _dmarc                       "v=DMARC1; p=none;"
#             (upgrade to p=quarantine or p=reject once stable)
#
#   d. Click "Verify" — DNS propagation can take up to 48 h but usually < 1 h
#
# STEP 3 — Create an API key
#   → Resend Dashboard → API Keys → Create API Key
#   → Name: "HotBot Production", Permission: "Sending access"
#   → Copy the key (shown once) → paste into RESEND_API_KEY above
#
# STEP 4 — Set env vars (Vercel)
#   → Vercel Dashboard → Project → Settings → Environment Variables
#   → Add:
#       RESEND_API_KEY       = re_xxxxxxxxxxxxxxxxxxxx   (from Step 3)
#       RESEND_FROM_EMAIL    = hello@hotbotstudios.com   (must be on verified domain)
#       RESEND_FROM_NAME     = HotBot Studios
#   → Redeploy the project (or wait for next auto-deploy)
#
# STEP 5 — Test
#   → Register a new user in Backdrop — you should get a welcome email
#   → Use Forgot Password — you should get an acknowledgment email
#   → Submit the contact / lead form — confirmation email to the visitor
#
# IMPORTANT: The GMAIL_APP_PASSWORD / GMAIL_FROM_EMAIL vars above are only used
# for invoice sending (SMTP). Resend handles all other transactional email.
# Both can coexist — they do not conflict.
#
# EMAIL TRIGGERS WIRED IN THIS APP:
#   • Registration         → sendRegistrationConfirmation  (welcome + pending approval notice)
#   • Password reset       → sendPasswordResetAcknowledgment (heads-up email)
#   • Contact form         → sendContactConfirmation       (visitor receipt)
#   • Lead / Get Started   → sendLeadConfirmation          (visitor receipt)
#   • Newsletter signup    → sendNewsletterWelcome         (welcome + unsubscribe link)
#   • Support ticket open  → sendTicketConfirmation        (ticket details)
#   • Staff reply on ticket→ sendStaffReplyNotification    (reply preview)
#   • Ticket status change → sendStatusUpdateNotification  (new status)
#   • Chat handoff request → sendChatTranscript            (chat history to visitor)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Google OAuth2 (for Google Meet + Calendar integration) ────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable APIs: Google Calendar API, Google Meet API, People API
# Add authorized redirect URI: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
