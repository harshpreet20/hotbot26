# ─── Copy this file to .env.local and fill in your values ───────────────────
# Architecture:
#   Frontend (Next.js) → /api/n8n/* → n8n webhooks → Google Sheets + Sarvam AI + AI Sensy
#   Admin panel → NextAuth.js + Neon Postgres (Vercel-compatible)

# ── Database (Neon Postgres / Vercel Postgres) ───────────────────────────────
# Auto-configured when you add Postgres from Vercel Storage tab.
# For local dev, create a free Neon project at https://neon.tech
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── NextAuth.js ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-32-char-string-here

# ── SMTP (Google Workspace — for password reset emails) ──────────────────────
# 1. Enable 2FA on your Google Workspace account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use that App Password below (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@hotbotstudios.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=HotBot Studios <noreply@hotbotstudios.com>

# ── Default Admin (used by seed script) ──────────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=hotbotstudios
DEFAULT_ADMIN_EMAIL=admin@hotbotstudios.com

# ── n8n Webhook Base URL ─────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.harshpreetbhasin.com

# ── n8n Webhook Endpoints ────────────────────────────────────────────────────
# All lead capture (forms, contact page) → single webhook → Google Sheets
N8N_WEBHOOK_LEADS=/webhook-test/hotbotstudios-leads

# AI text chat (n8n LLM workflow)
N8N_WEBHOOK_CHAT=/webhook-test/hotbotstudios.com

# Callback request → n8n → Sarvam AI outbound voice call
N8N_WEBHOOK_CALLBACK=/webhook-test/hotbotstudios-callback

# Newsletter subscriptions
N8N_WEBHOOK_NEWSLETTER=/webhook-test/hotbotstudios-newsletter

# Event tracking (fire-and-forget)
N8N_WEBHOOK_ANALYTICS=/webhook-test/hotbotstudios-analytics

# ── Google Analytics 4 ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-5CNWV5X1KC

# ── App URL (used for OpenGraph metadata) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hotbotstudios.com

# ── reCAPTCHA v3 (optional — forms work without it) ──────────────────────────
# 1. Go to https://www.google.com/recaptcha/admin/create
# 2. Choose reCAPTCHA v3 → add your domain (localhost for dev)
# 3. Copy Site Key (public) and Secret Key (server-only)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
