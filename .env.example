# ─── Copy this file to .env.local and fill in your values ───────────────────
# Architecture:
#   Frontend (Next.js) → /api/n8n/* → n8n webhooks → Google Sheets + Sarvam AI + AI Sensy

# ── n8n Webhook Base URL ─────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.harshpreetbhasin.com

# ── n8n Webhook Endpoints ────────────────────────────────────────────────────
# All lead capture (forms, contact page) → single webhook → Google Sheets
N8N_WEBHOOK_LEADS=/webhook-test/hotbotstudios-leads

# AI text chat (n8n LLM workflow)
N8N_WEBHOOK_CHAT=/webhook-test/hotbotstudios.com

# Callback request → n8n → Sarvam AI outbound voice call
N8N_WEBHOOK_CALLBACK=/webhook-test/hotbotstudios-callback

# Newsletter subscriptions
N8N_WEBHOOK_NEWSLETTER=/webhook-test/hotbotstudios-newsletter

# Event tracking (fire-and-forget)
N8N_WEBHOOK_ANALYTICS=/webhook-test/hotbotstudios-analytics

# ── Google Analytics 4 ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-5CNWV5X1KC

# ── App URL (used for OpenGraph metadata) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hotbotstudios.com

# ── reCAPTCHA v3 (optional — forms work without it) ──────────────────────────
# 1. Go to https://www.google.com/recaptcha/admin/create
# 2. Choose reCAPTCHA v3 → add your domain (localhost for dev)
# 3. Copy Site Key (public) and Secret Key (server-only)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project: wsucqpunleplgyrrroae | Region: ap-northeast-2
# Get these from: https://supabase.com/dashboard/project/wsucqpunleplgyrrroae/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://wsucqpunleplgyrrroae.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key — SERVER SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
