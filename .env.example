# ─── Copy this file to .env.local and fill in your values ───────────────────
# Architecture:
#   Next.js API routes → local filesystem storage (CRM is fully native)
#   Chat / Voice / Blog → N8N workflow webhooks

# ── N8N Workflow Webhooks (active) ────────────────────────────────────────────
# Workflow 1 — Forms (initial lead intake)
N8N_WEBHOOK_FORMS=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-forms

# Workflow 2 — Chat (AI + Human Handoff)
N8N_WEBHOOK_CHAT=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-chat

# Workflow 3 — Voice Agent (Sarvam AI outbound call trigger)
N8N_WEBHOOK_VOICE=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-voice

# Workflow 8 — Blog Create & Publish
N8N_WEBHOOK_BLOG_CREATE=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-blog-create

# Workflow 9 — Blog Auth (Backdrop login) — do not remove
# When set, all login attempts (super admin + sub-accounts) route through this N8N
# webhook, which validates credentials against the existing database via
# /api/blog/auth/validate, then the auth route creates the session locally.
# Falls back to direct DB auth if N8N is unreachable.
N8N_WEBHOOK_BLOG_AUTH_URL=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-blog-auth

# Shared secret between this app and N8N — set the same value in both:
#   App:  N8N_AUTH_SECRET (here)
#   N8N:  Environment variable N8N_AUTH_SECRET in your n8n instance
# /api/blog/auth/validate rejects requests that do not include this secret in
# the X-N8N-Secret header, preventing unauthenticated credential-check abuse.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_AUTH_SECRET=your_n8n_auth_secret_here

# Workflow 10 — Blog → Google Sheets Backup
N8N_WEBHOOK_BLOG_SHEETS=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-blog-sheets

# ── Google Analytics 4 ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-5CNWV5X1KC

# ── App URL (used for OpenGraph metadata) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hotbotstudios.com

# ── Blog / Backdrop admin ────────────────────────────────────────────────────
# Username for the env-var fallback admin account (defaults to "admin")
BLOG_ADMIN_USERNAME=admin
# bcrypt hash of the admin password (cost 12). Pre-hashed for: Hotbotstudios
# Regenerate with: node -e "require('bcryptjs').hash('YourNewPassword',12).then(console.log)"
BLOG_ADMIN_PASSWORD_HASH='$2b$12$nMk6oS00R.r9/qLpZbClSODAXxibghu4SBa7fv.QqVFUUJqay6Qiu'
# Random secret used for legacy API access and N8N webhook auth
BLOG_PUBLISH_SECRET=d4fb0c403a1a5a909ab66027443b0a66c03f400cc7647be2059c4682654cb841

# ── reCAPTCHA v3 (optional — forms work without it) ──────────────────────────
# 1. Go to https://www.google.com/recaptcha/admin/create
# 2. Choose reCAPTCHA v3 → add your domain (localhost for dev)
# 3. Copy Site Key (public) and Secret Key (server-only)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ── GitHub (optional — blog post persistence across Vercel redeploys) ─────────
GITHUB_TOKEN=
GITHUB_REPO=harshpreet20/hotbot26
GITHUB_BRANCH=main

# ── Google Workspace Email (invoice sending via Gmail SMTP) ───────────────────
# 1. Use a Google Workspace account (e.g. billing@hotbotstudios.com)
# 2. Enable 2-Step Verification on the Google Workspace account
# 3. Generate an App Password: Google Account → Security → App Passwords
#    (Select app: Mail, device: Other → name it "HotBot Invoices")
# 4. Paste the 16-character App Password (no spaces) into GMAIL_APP_PASSWORD
#
# SMTP settings (hardcoded): host=smtp.gmail.com, port=587, STARTTLS
GMAIL_FROM_NAME=HotBot Studios
GMAIL_FROM_EMAIL=billing@hotbotstudios.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ── Supabase (Auth + Database) ───────────────────────────────────────────────
# Project URL (always public):
SUPABASE_URL=https://wsucqpunleplgyrrroae.supabase.co
# Service role key — get from: Supabase Dashboard → Project Settings → API → service_role
# WARNING: Never expose this key on the client side. Server/API routes only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
#
# Supabase Auth is used for all Backdrop (admin dashboard) authentication:
#  - Registration with email verification
#  - Login (email + password)
#  - Password reset via email
#  - Admin approval workflow via backdrop_users table
#
# Tables: leads, contacts, callbacks, newsletter, chats, crm_tasks, invoices,
#         tickets, posts, audit_logs, system_logs, team_messages, seo_scores,
#         analytics_snapshots, topic_suggestions, crm_updates, backdrop_users,
#         team_channels, sessions
#
# When these vars are set, all data and authentication go through Supabase.
# Without them, the app falls back to local JSON files + bcrypt auth (dev mode).
#
# First-time setup: The first successful login via Supabase Auth is automatically
# bootstrapped as super_admin (if no approved users exist yet).
