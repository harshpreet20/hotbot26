# N8N Configuration
NEXT_PUBLIC_N8N_BASE_URL=https://n8n.harshpreetbhasin.com

# N8N webhook for admin login authentication
NEXT_PUBLIC_N8N_WEBHOOK_BLOG_AUTH=/webhook/hotbotstudios-blog-auth

# N8N webhook for creating blog posts (N8N → Claude → publish)
NEXT_PUBLIC_N8N_WEBHOOK_BLOG_CREATE=/webhook/hotbotstudios-blog-create

# Main site URL
NEXT_PUBLIC_MAIN_SITE_URL=https://hotbotstudios.com
