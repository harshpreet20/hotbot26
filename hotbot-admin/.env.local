# N8N Configuration
# Base already includes /webhook/ — paths below are just the webhook name
NEXT_PUBLIC_N8N_BASE_URL=https://hotbotst.app.n8n.cloud/webhook/

# Admin login authentication
NEXT_PUBLIC_N8N_WEBHOOK_BLOG_AUTH=https://hotbotst.app.n8n.cloud/webhook/hotbotstudios-blog-auth

# Blog post creation (N8N → Claude → publish to main site)
NEXT_PUBLIC_N8N_WEBHOOK_BLOG_CREATE=hotbotstudios-blog-create

# Main site URL
NEXT_PUBLIC_MAIN_SITE_URL=https://hotbotstudios.com
