# ─── HotBot Admin — Environment Variables ────────────────────────────
# Copy this file to .env.local and fill in your values before running.
# On Vercel: add all of these as Environment Variables in the project settings.
# ─────────────────────────────────────────────────────────────────────

# ── PUBLIC (exposed to browser) ───────────────────────────────────────

# Your running N8N instance base URL (no trailing slash)
# e.g. https://your-n8n.railway.app  OR  https://n8n.hotbotstudios.com
NEXT_PUBLIC_N8N_BASE_URL=https://your-n8n-instance.com/webhook

# Webhook path for the 08-blog-auth.json workflow
NEXT_PUBLIC_N8N_WEBHOOK_BLOG_AUTH=hotbotstudios-blog-auth

# Webhook path for the 09-blog-create-publish.json workflow
NEXT_PUBLIC_N8N_WEBHOOK_BLOG_CREATE=hotbotstudios-blog-create

# The main HotBot Studios site URL (for fetching posts list and view links)
NEXT_PUBLIC_MAIN_SITE_URL=https://hotbotstudios.com

# ── SERVER-SIDE ONLY (never exposed to browser) ───────────────────────

# Must match BLOG_PUBLISH_SECRET in hotbot-studios/.env.local
# Used by the /api/publish proxy route — keeps the secret off the client
BLOG_PUBLISH_SECRET=your-blog-publish-secret-here

# Internal URL for the server-side proxy to reach the main site
# Can differ from NEXT_PUBLIC_MAIN_SITE_URL (e.g. internal Docker hostname)
MAIN_SITE_URL=https://hotbotstudios.com
