# N8N Configuration
# Copy this file to .env.local and fill in your values.

# Your N8N instance base URL
NEXT_PUBLIC_N8N_BASE_URL=https://n8n.harshpreetbhasin.com

# N8N webhook path for blog auth (admin login)
# N8N should: check username/password → return { token, success } or { error }
NEXT_PUBLIC_N8N_WEBHOOK_BLOG_AUTH=/webhook/hotbotstudios-blog-auth

# N8N webhook path for creating/updating blog posts
# N8N should: validate token → call Claude API → POST to main site /api/blog/publish → return { success, url }
NEXT_PUBLIC_N8N_WEBHOOK_BLOG_CREATE=/webhook/hotbotstudios-blog-create

# Main site URL (for links and preview)
NEXT_PUBLIC_MAIN_SITE_URL=https://hotbotstudios.com
