{
  "workflow": {
    "name": "Hotbot Studios AI Chatbot Workflow",
    "version": "1.0.0",
    "description": "Two-layer chatbot system: AI Agent with Google Drive knowledge base and Live Chat via AI Sensy",
    "layers": {
      "layer_1_ai_chatbot": {
        "name": "AI Chatbot - Knowledge Base Agent",
        "description": "AI Agent that answers queries using Hotbot Studios data from Google Drive",
        "nodes": [
          {
            "id": "node_1",
            "type": "trigger",
            "name": "Chat Trigger",
            "config": {
              "trigger_type": "webhook",
              "endpoint": "/api/chat",
              "method": "POST",
              "input_schema": {
                "user_message": "string",
                "session_id": "string",
                "user_id": "string",
                "timestamp": "string"
              }
            }
          },
          {
            "id": "node_2",
            "type": "data_source",
            "name": "Google Drive Connector",
            "config": {
              "provider": "google_drive",
              "authentication": {
                "type": "oauth2",
                "credentials_ref": "{{GOOGLE_DRIVE_CREDENTIALS}}"
              },
              "source_folder_id": "{{HOTBOT_STUDIOS_FOLDER_ID}}",
              "supported_file_types": [
                "application/pdf",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                "application/vnd.google-apps.document",
                "application/vnd.google-apps.spreadsheet",
                "text/csv"
              ],
              "sync_schedule": {
                "frequency": "daily",
                "time": "02:00",
                "timezone": "UTC"
              },
              "recursive_scan": true
            }
          },
          {
            "id": "node_3",
            "type": "document_processor",
            "name": "Document Extraction & Parsing",
            "config": {
              "input_from": "node_2",
              "extraction_methods": {
                "pdf": {
                  "engine": "ocr_and_text",
                  "ocr_provider": "tesseract",
                  "extract_tables": true,
                  "extract_images": false
                },
                "excel": {
                  "read_all_sheets": true,
                  "preserve_formatting": false,
                  "extract_formulas": false
                },
                "docx": {
                  "extract_headers": true,
                  "extract_tables": true,
                  "preserve_structure": true
                }
              },
              "chunking": {
                "strategy": "recursive_text_splitter",
                "chunk_size": 1000,
                "chunk_overlap": 200,
                "separators": ["\n\n", "\n", ". ", " "]
              },
              "embedding": {
                "model": "text-embedding-ada-002",
                "dimensions": 1536
              },
              "vector_store": {
                "provider": "pinecone",
                "index_name": "hotbot-studios-kb",
                "namespace": "default",
                "credentials_ref": "{{VECTOR_DB_CREDENTIALS}}"
              }
            }
          },
          {
            "id": "node_4",
            "type": "guardrails",
            "name": "Input Guardrails",
            "config": {
              "input_from": "node_1",
              "checks": [
                {
                  "type": "content_moderation",
                  "enabled": true,
                  "block_categories": [
                    "hate_speech",
                    "violence",
                    "sexual_content",
                    "self_harm",
                    "illegal_activity"
                  ],
                  "sensitivity": "medium"
                },
                {
                  "type": "prompt_injection_detection",
                  "enabled": true,
                  "action_on_detect": "block_and_log"
                },
                {
                  "type": "pii_detection",
                  "enabled": true,
                  "action": "mask",
                  "pii_types": [
                    "credit_card",
                    "ssn",
                    "phone_number",
                    "email"
                  ]
                },
                {
                  "type": "topic_restriction",
                  "enabled": true,
                  "allowed_topics": [
                    "hotbot_studios_services",
                    "hotbot_studios_products",
                    "hotbot_studios_pricing",
                    "hotbot_studios_team",
                    "hotbot_studios_portfolio",
                    "general_inquiries",
                    "support"
                  ],
                  "off_topic_response": "I can only help with questions related to Hotbot Studios. How can I assist you with our services?"
                },
                {
                  "type": "rate_limiting",
                  "enabled": true,
                  "max_requests_per_minute": 20,
                  "max_requests_per_session": 100
                }
              ],
              "on_block": {
                "action": "return_safe_response",
                "message": "I'm sorry, I can't process that request. Please rephrase your question about Hotbot Studios."
              }
            }
          },
          {
            "id": "node_5",
            "type": "retrieval",
            "name": "Knowledge Base Retrieval (RAG)",
            "config": {
              "input_from": "node_4",
              "vector_store": {
                "provider": "pinecone",
                "index_name": "hotbot-studios-kb",
                "namespace": "default"
              },
              "retrieval_config": {
                "strategy": "similarity_search",
                "top_k": 5,
                "score_threshold": 0.75,
                "reranking": {
                  "enabled": true,
                  "model": "cross-encoder"
                }
              }
            }
          },
          {
            "id": "node_6",
            "type": "ai_agent",
            "name": "Hotbot Studios AI Agent",
            "config": {
              "input_from": ["node_4", "node_5"],
              "llm": {
                "provider": "openai",
                "model": "gpt-4o",
                "temperature": 0.3,
                "max_tokens": 1024,
                "credentials_ref": "{{OPENAI_API_KEY}}"
              },
              "system_prompt": "You are the official AI assistant for Hotbot Studios. You help users with questions about Hotbot Studios' services, products, pricing, team, portfolio, and general inquiries. Always be professional, helpful, and accurate. Only use the provided context to answer questions. If you don't have enough information, politely let the user know and suggest they connect with a live agent. Never make up information.",
              "context_template": "Use the following retrieved context to answer the user's question:\n\n---CONTEXT---\n{{retrieved_documents}}\n---END CONTEXT---\n\nUser Question: {{user_message}}",
              "memory": {
                "type": "conversation_buffer",
                "max_history": 10,
                "storage": "session"
              },
              "fallback": {
                "enabled": true,
                "trigger": "low_confidence",
                "confidence_threshold": 0.5,
                "action": "escalate_to_live_chat",
                "redirect_to": "layer_2_live_chat"
              }
            }
          },
          {
            "id": "node_7",
            "type": "guardrails",
            "name": "Output Guardrails",
            "config": {
              "input_from": "node_6",
              "checks": [
                {
                  "type": "hallucination_detection",
                  "enabled": true,
                  "method": "context_grounding_check",
                  "threshold": 0.8
                },
                {
                  "type": "content_moderation",
                  "enabled": true,
                  "block_categories": [
                    "hate_speech",
                    "violence",
                    "sexual_content"
                  ]
                },
                {
                  "type": "brand_compliance",
                  "enabled": true,
                  "blocked_phrases": [
                    "competitor names",
                    "negative brand mentions"
                  ],
                  "tone": "professional_and_friendly"
                },
                {
                  "type": "factual_consistency",
                  "enabled": true,
                  "verify_against": "retrieved_context"
                }
              ],
              "on_block": {
                "action": "regenerate_or_fallback",
                "max_retries": 2,
                "fallback_message": "I want to make sure I give you accurate information. Let me connect you with our team for the best answer."
              }
            }
          },
          {
            "id": "node_8",
            "type": "response",
            "name": "Chat Response",
            "config": {
              "input_from": "node_7",
              "output_schema": {
                "response_text": "string",
                "confidence_score": "number",
                "sources": "array",
                "session_id": "string",
                "escalation_needed": "boolean"
              }
            }
          }
        ],
        "flow": [
          "node_1 -> node_4",
          "node_4 -> node_5",
          "node_5 -> node_6",
          "node_1 -> node_6 (session context)",
          "node_6 -> node_7",
          "node_7 -> node_8"
        ]
      },

      "layer_2_live_chat": {
        "name": "Live Chat - AI Sensy Integration",
        "description": "Live chat escalation and direct human agent connection via AI Sensy HTTP node",
        "nodes": [
          {
            "id": "node_lc_1",
            "type": "trigger",
            "name": "Live Chat Trigger",
            "config": {
              "trigger_sources": [
                {
                  "type": "user_request",
                  "keywords": ["talk to agent", "live chat", "human agent", "speak to someone", "connect me"]
                },
                {
                  "type": "escalation",
                  "from": "layer_1_ai_chatbot",
                  "condition": "low_confidence_or_fallback"
                },
                {
                  "type": "direct_entry",
                  "endpoint": "/api/live-chat",
                  "method": "POST"
                }
              ],
              "input_schema": {
                "user_message": "string",
                "session_id": "string",
                "user_id": "string",
                "conversation_history": "array",
                "escalation_reason": "string"
              }
            }
          },
          {
            "id": "node_lc_2",
            "type": "http_node",
            "name": "AI Sensy HTTP Connector",
            "config": {
              "base_url": "{{AI_SENSY_API_BASE_URL}}",
              "authentication": {
                "type": "api_key",
                "header": "Authorization",
                "value": "Bearer {{AI_SENSY_API_KEY}}"
              },
              "endpoints": {
                "initiate_chat": {
                  "method": "POST",
                  "path": "/api/v1/chat/initiate",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "session_id": "{{session_id}}",
                    "user_id": "{{user_id}}",
                    "user_name": "{{user_name}}",
                    "channel": "web",
                    "conversation_history": "{{conversation_history}}",
                    "escalation_reason": "{{escalation_reason}}",
                    "metadata": {
                      "source": "hotbot_studios_chatbot",
                      "ai_confidence_score": "{{confidence_score}}",
                      "last_ai_response": "{{last_ai_response}}"
                    }
                  },
                  "timeout_ms": 30000
                },
                "send_message": {
                  "method": "POST",
                  "path": "/api/v1/chat/message",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "session_id": "{{session_id}}",
                    "message": "{{user_message}}",
                    "sender": "user",
                    "timestamp": "{{timestamp}}"
                  },
                  "timeout_ms": 10000
                },
                "receive_message": {
                  "method": "GET",
                  "path": "/api/v1/chat/messages/{{session_id}}",
                  "polling_interval_ms": 2000,
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "timeout_ms": 10000
                },
                "end_chat": {
                  "method": "POST",
                  "path": "/api/v1/chat/end",
                  "body": {
                    "session_id": "{{session_id}}",
                    "reason": "{{end_reason}}"
                  },
                  "timeout_ms": 10000
                },
                "check_agent_availability": {
                  "method": "GET",
                  "path": "/api/v1/agents/availability",
                  "timeout_ms": 5000
                }
              },
              "retry_policy": {
                "max_retries": 3,
                "backoff_strategy": "exponential",
                "initial_delay_ms": 1000
              },
              "error_handling": {
                "on_timeout": {
                  "message": "Our live agents are currently busy. Please try again shortly or leave your contact details and we'll get back to you."
                },
                "on_no_agents_available": {
                  "message": "All our agents are currently assisting other customers. Would you like to leave a message or try our AI assistant?",
                  "fallback_to": "layer_1_ai_chatbot"
                },
                "on_connection_error": {
                  "message": "We're experiencing technical difficulties. Please try again in a moment.",
                  "retry": true
                }
              }
            }
          },
          {
            "id": "node_lc_3",
            "type": "websocket_handler",
            "name": "Real-time Message Handler",
            "config": {
              "websocket_url": "{{AI_SENSY_WS_URL}}",
              "events": {
                "on_agent_message": {
                  "action": "forward_to_user",
                  "format": {
                    "sender": "agent",
                    "message": "{{agent_message}}",
                    "timestamp": "{{timestamp}}"
                  }
                },
                "on_agent_typing": {
                  "action": "show_typing_indicator"
                },
                "on_agent_joined": {
                  "action": "notify_user",
                  "message": "A live agent has joined the chat. How can they help you?"
                },
                "on_agent_left": {
                  "action": "notify_user",
                  "message": "The agent has ended the chat. You're now back with our AI assistant."
                },
                "on_chat_ended": {
                  "action": "redirect_to",
                  "target": "layer_1_ai_chatbot"
                }
              }
            }
          },
          {
            "id": "node_lc_4",
            "type": "response",
            "name": "Live Chat Response",
            "config": {
              "output_schema": {
                "message": "string",
                "sender": "string",
                "session_id": "string",
                "agent_info": {
                  "name": "string",
                  "avatar": "string"
                },
                "chat_status": "string",
                "timestamp": "string"
              }
            }
          }
        ],
        "flow": [
          "node_lc_1 -> node_lc_2 (initiate_chat)",
          "node_lc_2 -> node_lc_3 (establish websocket)",
          "node_lc_3 <-> node_lc_4 (bidirectional messaging)"
        ]
      }
    },

    "global_config": {
      "environment_variables": {
        "GOOGLE_DRIVE_CREDENTIALS": "{{env.GOOGLE_DRIVE_CREDENTIALS}}",
        "HOTBOT_STUDIOS_FOLDER_ID": "{{env.HOTBOT_STUDIOS_FOLDER_ID}}",
        "VECTOR_DB_CREDENTIALS": "{{env.VECTOR_DB_CREDENTIALS}}",
        "OPENAI_API_KEY": "{{env.OPENAI_API_KEY}}",
        "AI_SENSY_API_KEY": "{{env.AI_SENSY_API_KEY}}",
        "AI_SENSY_API_BASE_URL": "{{env.AI_SENSY_API_BASE_URL}}",
        "AI_SENSY_WS_URL": "{{env.AI_SENSY_WS_URL}}"
      },
      "logging": {
        "enabled": true,
        "level": "info",
        "destinations": ["console", "cloud_logging"],
        "log_conversations": true,
        "redact_pii": true
      },
      "analytics": {
        "enabled": true,
        "track_events": [
          "chat_started",
          "message_sent",
          "ai_response_generated",
          "guardrail_triggered",
          "escalation_to_live_chat",
          "live_chat_started",
          "live_chat_ended",
          "user_satisfaction_rating"
        ]
      },
      "session_management": {
        "timeout_minutes": 30,
        "max_concurrent_sessions": 500,
        "storage": "redis"
      }
    }
  }
}
